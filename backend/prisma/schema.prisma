generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  isAdmin      Boolean       @default(false)
  firstName    String
  lastName     String
  username     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Settings {
  id                   String  @id @default("default")
  issuer               String
  acsUrl               String
  audience             String
  serviceProviderId    String  @default("")
  relayState           String  @default("")
  signResponse         Boolean @default(true)
  digestAlgorithm      String  @default("sha256")
  signatureAlgorithm   String  @default("rsa-sha256")
  lifetimeInSeconds    Int     @default(3600)
  authnContextClassRef String
  allowRequestAcsUrl   Boolean @default(true)
}

model SamlRequest {
  id         String    @id @default(uuid())
  samlId     String?
  issuer     String?
  acsUrl     String?
  relayState String?
  forceAuthn Boolean   @default(false)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}
